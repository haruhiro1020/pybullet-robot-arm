<?xml version="1.0"?>
<robot name="robot_3dof">

    <link name="base_link"/>

    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="5.0"/>
    </joint>

    <link name="link1">
        <visual>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.5"/>
            <mass value="1.0"/>
            <inertia ixx="0.0866667" iyy="0.0866667" izz="0.0066667" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0 1.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="5.0"/>
    </joint>

    <link name="link2">
        <visual>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.5"/>
            <mass value="1.0"/>
            <inertia ixx="0.0866667" iyy="0.0866667" izz="0.0066667" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0 0 1.0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="5.0"/>
    </joint>

    <link name="link3">
        <visual>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.5"/>
            <geometry><box size="0.2 0.2 1.0"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.5"/>
            <mass value="1.0"/>
            <inertia ixx="0.0866667" iyy="0.0866667" izz="0.0066667" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="ee_joint" type="fixed">
        <parent link="link3"/>
        <child link="ee_link"/>
        <origin xyz="0 0 1.0" rpy="0 0 0"/>
    </joint>

    <link name="ee_link">
        <visual>
            <geometry><sphere radius="0.05"/></geometry>
            <material name="red"><color rgba="1 0 0 1"/></material>
        </visual>
    </link>

</robot>
