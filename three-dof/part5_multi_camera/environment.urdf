<?xml version="1.0" ?>
<robot name="two_boxes_obstacle">

    <link name="base"/>

    <joint name="joint_box1" type="fixed">
        <parent link="base"/>
        <child link="box1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="box1">
        <visual>
            <origin xyz="1.8 0.5 0.8"/>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
            <material name="black"><color rgba="0 0 0 0.5"/></material>
        </visual>
        <collision>
            <origin xyz="1.8 0.5 0.8"/>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.0017" iyy="0.0842" izz="0.0842" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="joint_box2" type="fixed">
        <parent link="base"/>
        <child link="box2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="box2">
        <visual>
            <origin xyz="1.3 -0.2 0.8"/>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
            <material name="black"><color rgba="0 0 0 0.5"/></material>
        </visual>
        <collision>
            <origin xyz="1.3 -0.2 0.8"/>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.0017" iyy="0.0842" izz="0.0842" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="joint_sphere1" type="fixed">
        <parent link="base"/>
        <child link="sphere1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="sphere1">
        <visual>
            <origin xyz="1.0 -1.0 1.0"/>
            <geometry><sphere radius="0.2"/></geometry>
            <material name="blue"><color rgba="0 0 1.0 0.5"/></material>
        </visual>
    </link>

    <joint name="joint_sphere2" type="fixed">
        <parent link="base"/>
        <child link="sphere2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="sphere2">
        <visual>
            <origin xyz="1.0 1.0 1.0"/>
            <geometry><sphere radius="0.2"/></geometry>
            <material name="red"><color rgba="1.0 0 0 0.5"/></material>
        </visual>
    </link>

</robot>
